[Unit]
Description=mcar Agent Robot System
After=network.target

[Service]
Type=simple
WorkingDirectory=/root/mcar
Environment=PATH=/root/mcar/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=VIRTUAL_ENV=/root/mcar/.venv
Environment=MCAR_PROJECT_DIR=/root/mcar
Environment=MCAR_ENV_FILE=/root/mcar/.ai_pet_env
ExecStart=/bin/bash -lc 'set -a; [ -f "${MCAR_ENV_FILE}" ] && source "${MCAR_ENV_FILE}"; set +a; cd "${MCAR_PROJECT_DIR}/modules"; exec "${MCAR_PROJECT_DIR}/.venv/bin/python" -m robot_service'
Restart=on-failure
RestartSec=5
StartLimitIntervalSec=60
StartLimitBurst=5

# Ensure child tasks are killed on stop
KillMode=control-group
KillSignal=SIGTERM
TimeoutStopSec=10

# Resource limits
LimitNOFILE=4096
MemoryMax=512M

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mcar

[Install]
WantedBy=multi-user.target
