[
  {
    "capability_id": "tool.motion.forward",
    "name": "Move Forward",
    "type": "tool",
    "version": "1.0.0",
    "description": "Move the robot forward at a given speed for a given duration.",
    "risk_level": "NORMAL",
    "inputs_schema": {
      "type": "object",
      "properties": {
        "speed": { "type": "integer", "minimum": 0, "maximum": 100, "default": 50 },
        "duration_ms": { "type": "integer", "minimum": 100, "maximum": 5000, "default": 1000 }
      },
      "additionalProperties": false
    },
    "outputs_schema": {
      "type": "object",
      "properties": {
        "ok": { "type": "boolean" },
        "actual_duration_ms": { "type": "integer" }
      },
      "required": ["ok"]
    },
    "constraints": {
      "timeout_ms": 10000,
      "max_duration_ms": 5000,
      "cooldown_ms": 200,
      "concurrency": { "max_in_flight": 1, "mutex_group": "motion" }
    },
    "required_state_predicates": [
      { "key": "obstacle", "op": "==", "value": false, "on_fail": "DENY" }
    ],
    "permissions": {
      "roles_allowed": ["user", "admin"],
      "confirm_required": false
    },
    "idempotency": {
      "mode": "DEDUP_ONLY",
      "key_fields": ["speed", "duration_ms"],
      "ttl_ms": 2000
    },
    "observability": {
      "audit_level": "STANDARD",
      "log_inputs": true,
      "log_outputs": true,
      "redaction": []
    }
  },
