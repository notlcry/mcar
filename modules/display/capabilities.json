      },
      "required": ["text"],
      "additionalProperties": false
    },
    "outputs_schema": {
      "type": "object",
      "properties": {
        "ok": { "type": "boolean" },
        "lines_shown": { "type": "integer" }
      },
      "required": ["ok"]
