[
  {
    "capability_id": "tool.display.show_expression",
    "name": "Show Expression",
    "type": "tool",
    "version": "1.0.0",
    "description": "Display an expression/emotion on the OLED screen (happy, sad, thinking, confused, excited, sleeping, listening, speaking, neutral).",
    "risk_level": "NORMAL",
    "inputs_schema": {
      "type": "object",
      "properties": {
        "expression": {
          "type": "string",
          "enum": ["happy", "sad", "thinking", "confused", "excited", "sleeping", "listening", "speaking", "neutral"],
          "description": "Expression to display"
        }
      },
      "required": ["expression"],
      "additionalProperties": false
    },
    "outputs_schema": {
      "type": "object",
      "properties": {
        "ok": { "type": "boolean" },
        "expression": { "type": "string" }
      },
      "required": ["ok"]
    },
    "constraints": {
      "timeout_ms": 3000,
      "rate_limit": { "qps": 5, "burst": 10 }
    },
    "required_state_predicates": [],
    "permissions": {
      "roles_allowed": ["user", "admin"],
      "confirm_required": false
    },
    "idempotency": {
      "mode": "IDEMPOTENT",
      "key_fields": ["expression"],
      "ttl_ms": 1000
    },
    "observability": {
      "audit_level": "MINIMAL",
      "log_inputs": true,
      "log_outputs": false,
      "redaction": []
    }
  },
  {
    "capability_id": "tool.display.show_text",
